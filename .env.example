# ─── LLM Provider ─────────────────────────────────────────────────
# Gelistirme icin: ollama (ucretsiz, lokal)
# Demo icin: claude (Anthropic API)
LLM_PROVIDER=ollama

# Ollama (lokal LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Claude API (demo/production)
# https://console.anthropic.com — API key buradan alinir
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5-20251001

# ─── ChromaDB ─────────────────────────────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8000

# ─── Embedding Model ──────────────────────────────────────────────
EMBED_MODEL=intfloat/multilingual-e5-large

# ─── Reranker ─────────────────────────────────────────────────────
# Lokal: cross-encoder/ms-marco-MiniLM-L-6-v2
# Cohere: cohere (1000 req/ay ucretsiz)
RERANKER_PROVIDER=local
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
COHERE_API_KEY=

# ─── Gradio UI ────────────────────────────────────────────────────
GRADIO_USERNAME=demo
GRADIO_PASSWORD=kap2026
GRADIO_PORT=7860

# ─── API ──────────────────────────────────────────────────────────
API_PORT=8080
API_BASE_URL=http://localhost:8080

# ─── Logging ──────────────────────────────────────────────────────
LOG_LEVEL=INFO